{
  // Dev container for the IDS706 Week 11 assignment.
  // Airflow itself runs in Docker Compose (infra/docker-compose.yml); this container
  // gives you Python + Node + the Docker CLI to drive it and to run the agent loop.
  "name": "automl-research-lab (IDS706 Week 11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "pip install -r requirements-assignment.txt && cp -n .env.example .env || true",
  "forwardPorts": [8088, 8000, 5173],
  "portsAttributes": {
    "8088": { "label": "Airflow UI" },
    "8000": { "label": "Gateway API" },
    "5173": { "label": "Agent graph UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
